PORT=5000
# Leave MONGO_URI empty to run against an in-memory MongoDB that is auto-seeded on startup (demo mode).
MONGO_URI=mongodb://127.0.0.1:27017/prepstack-careeros
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:5173

# Existing Prepstack integration.
# Base URL of the existing Prepstack web app - used to deep-link roadmap modules, coding practice and mock interviews.
PREPSTACK_BASE_URL=http://localhost:3000
# Optional: existing Prepstack API. When set, roadmap/practice lookups are fetched from it, falling back to the local catalog.
PREPSTACK_API_URL=

# Optional: enables Claude-written drafts in the Application Copilot. Without it, deterministic grounded templates are used.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
